<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:id="@+id/widget_tasks_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Tooler Tasks Background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header: Tasks Icon, Title, Badge & Add Button -->
        <LinearLayout
            android:id="@+id/widget_tasks_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/widget_tasks_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:contentDescription="Tasks Icon" />

            <TextView
                android:id="@+id/widget_tasks_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="7dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="TASKS &amp; NOTES" />

            <TextView
                android:id="@+id/widget_tasks_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="9sp"
                android:textStyle="bold"
                android:text="ACTIVE" />

            <!-- Add Task [+] Button -->
            <FrameLayout
                android:id="@+id/widget_btn_add_task"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/widget_tile_ripple">

                <ImageView
                    android:id="@+id/widget_btn_add_task_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Add Task" />
            </FrameLayout>
        </LinearLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="6dp"
            android:background="#20808080" />

        <!-- Content Area -->
        <LinearLayout
            android:id="@+id/widget_tasks_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/widget_tasks_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/widget_tasks_empty_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="All Done Icon" />

                <TextView
                    android:id="@+id/widget_tasks_empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textSize="11sp"
                    android:text="No pending tasks!\nTap + to add one" />
            </LinearLayout>

            <!-- Task Row 1 -->
            <LinearLayout
                android:id="@+id/widget_task_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/widget_task_check_1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="Check Task 1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/widget_task_title_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="Task Title" />

                    <TextView
                        android:id="@+id/widget_task_sub_1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="9.5sp"
                        android:text="Category • Priority" />
                </LinearLayout>
            </LinearLayout>

            <!-- Task Row 2 -->
            <LinearLayout
                android:id="@+id/widget_task_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/widget_task_check_2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="Check Task 2" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/widget_task_title_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="Task Title" />

                    <TextView
                        android:id="@+id/widget_task_sub_2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="9.5sp"
                        android:text="Category • Priority" />
                </LinearLayout>
            </LinearLayout>

            <!-- Task Row 3 -->
            <LinearLayout
                android:id="@+id/widget_task_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/widget_task_check_3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="Check Task 3" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/widget_task_title_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="Task Title" />

                    <TextView
                        android:id="@+id/widget_task_sub_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="9.5sp"
                        android:text="Category • Priority" />
                </LinearLayout>
            </LinearLayout>

            <!-- Task Row 4 -->
            <LinearLayout
                android:id="@+id/widget_task_row_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/widget_task_check_4"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="Check Task 4" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/widget_task_title_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="Task Title" />

                    <TextView
                        android:id="@+id/widget_task_sub_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="9.5sp"
                        android:text="Category • Priority" />
                </LinearLayout>
            </LinearLayout>

            <!-- Task Row 5 -->
            <LinearLayout
                android:id="@+id/widget_task_row_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:id="@+id/widget_task_check_5"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="Check Task 5" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/widget_task_title_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:text="Task Title" />

                    <TextView
                        android:id="@+id/widget_task_sub_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="9.5sp"
                        android:text="Category • Priority" />
                </LinearLayout>
            </LinearLayout>

            <!-- More tasks footer -->
            <TextView
                android:id="@+id/widget_tasks_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:text="+ 2 more tasks in app"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
