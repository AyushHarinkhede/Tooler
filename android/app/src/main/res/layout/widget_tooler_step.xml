<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_step_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <ImageView
        android:id="@+id/widget_step_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Tooler Step Counter Background" />

    <LinearLayout
        android:id="@+id/widget_step_click_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/widget_tile_ripple">

        <!-- Top Header: Step Icon, Title & Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/widget_step_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="fitCenter"
                android:contentDescription="Step Icon" />

            <TextView
                android:id="@+id/widget_step_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="STEPS" />

            <TextView
                android:id="@+id/widget_step_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textStyle="bold"
                android:text="TODAY" />
        </LinearLayout>

        <!-- Center: Prominent Steps Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/widget_step_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="36sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:text="0" />

            <TextView
                android:id="@+id/widget_step_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>

        <!-- Bottom Trio Metrics: Distance · Avg Speed · Calories (3x2 Wide Cell) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="2dp"
            android:gravity="center">

            <!-- Distance Metric -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/widget_step_dist_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Distance" />

                <TextView
                    android:id="@+id/widget_step_dist_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:text="0.0 km" />

                <TextView
                    android:id="@+id/widget_step_dist_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="8.5sp"
                    android:text="Distance" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#1A888888" />

            <!-- Speed Metric -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/widget_step_speed_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Avg Speed" />

                <TextView
                    android:id="@+id/widget_step_speed_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:text="0.0 km/h" />

                <TextView
                    android:id="@+id/widget_step_speed_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="8.5sp"
                    android:text="Avg Speed" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#1A888888" />

            <!-- Calories Metric -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/widget_step_cal_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Calories" />

                <TextView
                    android:id="@+id/widget_step_cal_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:text="0 kcal" />

                <TextView
                    android:id="@+id/widget_step_cal_lbl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="8.5sp"
                    android:text="Calories" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
